# Base URL of your HortusFox instance (no trailing slash needed)
HORTUSFOX_URL=https://garden.example.com

# API key generated in the HortusFox admin panel (Admin > API)
HORTUSFOX_API_TOKEN=your-api-token-here

# Optional: request timeout in milliseconds (default 30000)
# HORTUSFOX_TIMEOUT=30000

# Optional: directory local files may be uploaded from (photos, attachments).
# Unset, every upload tool refuses.
# HORTUSFOX_UPLOAD_DIR=/home/me/hortusfox-uploads

# Optional: upload size ceiling in MiB (default 25)
# HORTUSFOX_MAX_UPLOAD_MB=25
